{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "node",
    "typeRoots": [
      "src/@types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true,
    "sourceMap": false,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.*",
    "**/__mocks__/*",
    "**/__tests__/*"
  ]
}
