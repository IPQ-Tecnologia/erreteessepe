# MediaMTX
MEDIAMTX_HOST=localhost
MEDIAMTX_API=http://localhost:9997
AUTH_PROVIDER=keycloak

# MediaMTX API credentials (Keycloak user when AUTH_PROVIDER=keycloak)
MEDIAMTX_API_USER=backend
MEDIAMTX_API_PASS=backendpassword

# Ports
RTSP_PORT=8554
WEBRTC_PORT=8889

# WebRTC viewer fallback credentials (used only when AUTH_PROVIDER=internal)
WEBRTC_USER=viewer
WEBRTC_PASS=strongpassword

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=mediamtx
KEYCLOAK_CLIENT_ID=mediamtx
KEYCLOAK_CLIENT_SECRET=mediamtx-dev-secret

PUBLIC_WEBRTC_HOST=localhost

# Business rules
MAX_VIEWERS=5
MEDIAMTX_READY_TIMEOUT_SECONDS=20
IDLE_ROOM_CLEANUP_SECONDS=20
MEDIAMTX_SOURCE_CLOSE_AFTER=20s
