APP_PORT=8000
CORS_ALLOW_ORIGIN=*

# LiveKit credentials must match deploy/livekit/livekit.yaml keys.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_2026
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
CAMERA_ROOM_PREFIX=camera
VIEWER_TOKEN_TTL_SECONDS=3600

# Shared status file written by camera_ingest and read by FastAPI.
INGEST_STATUS_FILE=runtime/ingest-status.json

# Camera sources (add as many as needed).
RTSP_CAMERA_CAM1_URL=rtsp://user:pass@camera-host:554/stream
RTSP_CAMERA_CAM2_URL=
RTSP_CAMERA_DSS_URL=

# Ingest tuning
RTSP_TRANSPORT=tcp
RTSP_RW_TIMEOUT_US=10000000
INGEST_RETRY_BASE_SECONDS=2
INGEST_RETRY_MAX_SECONDS=30
INGEST_FFMPEG_LOGLEVEL=warning
INGEST_PUBLISH_PROTOCOL=auto
INGEST_PROBE_SIZE_BYTES=32768
INGEST_ANALYZE_DURATION_US=0
INGEST_REORDER_QUEUE_SIZE=0
INGEST_MAX_DELAY_US=0
INGEST_ENABLE_H264_PASSTHROUGH=true
INGEST_TRANSCODE_BITRATE=2500k
INGEST_TRANSCODE_BUFSIZE=500k
INGEST_TRANSCODE_GOP=30
INGEST_TRANSCODE_PRESET=ultrafast
INGEST_TRANSCODE_THREADS=1
