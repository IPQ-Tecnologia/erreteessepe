# Runtime mode
AUTH_PROVIDER=keycloak
MEDIA_AUTH_MODE=internal_jwt

# MediaMTX API credentials.
# Used when MEDIA_AUTH_MODE is not internal_jwt and/or AUTH_PROVIDER requires it.
MEDIAMTX_API_USER=backend
MEDIAMTX_API_PASS=backendpassword

# Camera catalog / Redis
CAMERA_REDIS_URL=redis://redis:6379/0
CAMERA_REDIS_PREFIX=camera:
CAMERA_REDIS_TIMEOUT_SECONDS=2
CAMERA_DEFAULT_MANUFACTURER=dahua
CAMERA_DEFAULT_PORT=554
CAMERA_DEFAULT_CHANNEL=1
CAMERA_DEFAULT_SUBTYPE=0

# WebRTC
WEBRTC_PORT=8889
WHEP_URL=http://localhost:8889
WEBRTC_USER=viewer
WEBRTC_PASS=strongpassword
PUBLIC_WEBRTC_HOST=localhost
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Keycloak
KEYCLOAK_REALM=your-realm
KEYCLOAK_BASE_URL=https://your-keycloak.example.com
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_CERTIFICATE=
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
STREAM_ACCESS_ROLE=stream:read

# Backend-issued JWT for MediaMTX.
# Set either MEDIAMTX_JWT_PRIVATE_KEY or MEDIAMTX_JWT_PRIVATE_KEY_PATH.
# If both are empty, the API generates an in-memory key at startup.
MEDIAMTX_JWT_ISSUER=stream-api
MEDIAMTX_JWT_PRIVATE_KEY=
MEDIAMTX_JWT_PRIVATE_KEY_PATH=
MEDIAMTX_JWT_KID=mediamtx-internal-dev
MEDIAMTX_JWT_TTL_SECONDS=60
MEDIAMTX_API_TOKEN_TTL_SECONDS=60
MEDIAMTX_ADMIN_SUBJECT=mediamtx-admin

# TURN / ICE
TURN_ENABLED=false
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpassword

# Business rules
MAX_VIEWERS=5
MEDIAMTX_READY_TIMEOUT_SECONDS=20
IDLE_ROOM_CLEANUP_SECONDS=20

