{
  "realm": "mediamtx",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "teste-mediamtx"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mediamtx",
      "name": "MediaMTX",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mediamtx-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "mediamtx_permissions",
          "protocol": "openid-connect",
          "protocolMapper": "script-mediamtx-permissions-mapper.js",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "lightweight.claim": "true",
            "access.token.claim": "true",
            "claim.name": "mediamtx_permissions",
            "jsonType.label": "JSON"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "firstName": "Stream",
      "lastName": "Viewer",
      "email": "viewer@mediamtx.local",
      "emailVerified": true,
      "realmRoles": [
        "teste-mediamtx"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "viewer123",
          "temporary": false
        }
      ]
    },
    {
      "username": "backend",
      "enabled": true,
      "firstName": "Stream",
      "lastName": "Backend",
      "email": "backend@mediamtx.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "backendpassword",
          "temporary": false
        }
      ]
    }
  ]
}
